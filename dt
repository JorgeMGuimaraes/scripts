#! /usr/bin/python3
"List or run desktop shortcuts"
import sys
from os import system
from os.path import expandvars as p_expand, join as p_join
from typing import List
from utils import load_data

class Option():
    """A Option, script or utility"""
    def __init__(self, description, cmd, shortcut) -> None:
        self.description    = description
        self.cmd            = cmd
        self.shortcut       = shortcut
        return

    def __str__(self) -> str:
        return f"{self.description} ({self.shortcut})"

def load_options(file) -> List[Option]:
    """
    Returns a list of Options from json file.
    """
    return [Option(option['description'], option['cmd'], option['shortcut']) \
            for option in load_data(file)['options']]

def display_options_menu(options: List[Option]) -> None:
    """
    Display the options menu.
    """
    for i, menu_option in enumerate(options):
        print(f"[{i:<2}] - ({menu_option.shortcut}) {menu_option.description}")
    print(f"[{len(options):<2}] - Exit")
    return

def get_user_choice(max_val: int) -> int:
    """
    Returns the user choice.
    """
    should_continue = True
    while should_continue:
        try:
            user_choice = int(input("\nEnter your choice: "))
            if user_choice == max_val:
                print('Exiting\n')
                exit(0)
            elif user_choice > 0 and user_choice < max_val:
                return user_choice
        except ValueError:
            print("Invalid choice.")

if __name__ == '__main__':
    DATA_PATH   = '/usr/local/etc'
    DATA        = 'desktop_utilities.json'
    dt_options  = load_options(p_expand(p_join(DATA_PATH, DATA)))
    if len(sys.argv) > 1:
        for option in dt_options:
            if option.shortcut == sys.argv[1]:
                system(f"{option.cmd} {sys.argv[:1]}")
                exit(0)

    display_options_menu(dt_options)
    choice      = get_user_choice(len(dt_options))
    system(dt_options[choice].cmd)
