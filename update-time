#! /usr/bin/env python3

import sys
from utils import get_process, is_help_needed, show_help

def do():
    cmds = []
    cmds.append(['printf', 'Current time: '])
    cmds.append(['date'])
    cmds.append(['sudo', 'timedatectl', 'set-ntp', 'off'])
    cmds.append(['sudo', 'timedatectl', 'set-ntp', 'on'])
    cmds.append(['printf', 'Updated time: '])
    cmds.append(['date'])

    for cmd in cmds:
        result = get_process(cmd)
        if result.stdout != '': print(result.stdout)

    return

def start():
    if len(sys.argv) == 1:
        do()
        return
    if is_help_needed():
        show_help(sys.argv[0])
        return
    return

start()