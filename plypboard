def load_clipboard(path, key: str):
    """Load text from shelve object to clipboard"""
    with shelve.open(p_expand(path), flag='c') as file:
        value = file[key]
        pyperclip.copy(value)
        print(f"{value}")
    return

def list_clipboard(path):
    """List all keys in shelve object"""
    print("\nListing keys and values:")
    print(f"{p_expand(path)}.db")
    with shelve.open(p_expand(path), flag='c') as file:
        print(list(file.keys()))
        print(list(file.values()))
        for key in file.keys():
            print(f"[{key}]: {file[key]}")
    return

def delete_clipboard(path, key: str):
    """Delete key from shelve object"""
    with shelve.open(p_expand(path), flag='c') as file:
        del file[key]
    return

def shrink_text(value):
    """Shrink text to fit in clipboard"""
    limit = 20
    if len(value) > limit:
        return f"{value[:limit]} ..."

    return value

if __name__ == "__main__":
    USAGE       = "Usage: plypboard [(s)ave|(l)oad|(li)st|(d)elete] [key]"
    CLIP_PATH   = '$HOME/.config/clypeboard'
    CLIP_FILE   = p_join(p_expand(CLIP_PATH), 'clipboard')
    if not exists(p_expand(CLIP_PATH)):
        mkdir(p_expand(CLIP_PATH))

    if len(sys.argv) == 1:
        print(USAGE)
