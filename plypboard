#! /usr/bin/env python3
"""Serialize and deserialize clipboard data. Needs pyperclip module (pip) and xclip (os)."""
import sqlite3
import sys
from os import mkdir
from os.path import expandvars as p_expand, join as p_join, exists
try:
    import pyperclip
except ImportError:
    print("pyperclip is not installed. Try run 'pip install pyperclip'\n")
    exit(1)

def create_db(file_path: str):
    """Create a database file"""
    print(f"Creating database file: {file_path}")
    con = sqlite3.connect(file_path)
    with con:
        con.execute("CREATE TABLE clipboard (key TEXT, value TEXT)")
    con.close()
    return

def save_clipboard(file_path, key: str):
    """Save text from clipbloard to sqlite"""
    value   = pyperclip.paste()
    con     = sqlite3.connect(file_path)
    try:
        with con:
            con.execute("INSERT INTO clipboard VALUES (?, ?)", (key, value))
            print(f"{key}: {shrink_text(value)} saved.")
    except sqlite3.IntegrityError:
        print(f"Key '{key}' already exists in database, try update.")
    con.close()
    return

def update_clipboard(path, key: str):
    """Update value of key in sqlite"""
    value   = pyperclip.paste()
    con     = sqlite3.connect(path)
    try:
        with con:
            con.execute("UPDATE clipboard SET value=? WHERE key=?", (value, key))
            print(f"{key}: {shrink_text(value)} updated.")
    except sqlite3.IntegrityError:
        print(f"Key '{key}' not found in database.")
    con.close()
    return

def load_clipboard(file_path, key: str):
    """Load text from sqlite to clipboard"""
    con = sqlite3.connect(file_path)
    try:
        with con:
            value = con.execute("SELECT value FROM clipboard WHERE key=?", (key)).fetchone()[0]
            pyperclip.copy(value)
            print(f"{key}: {shrink_text(value)} loaded.")
    except sqlite3.IntegrityError:
        print(f"Key '{key}' not found in database.")
    con.close()
    return

def list_clipboard(path):
    """List all keys in sqlite"""
    print("\nListing keys and values:")
    con             = sqlite3.connect(path)
    con.row_factory = sqlite3.Row
    try:
        with con:
            cur = con.cursor()
            cur.execute("SELECT key, value FROM clipboard")
            for row in cur:
                print(f"{row['key']}: {shrink_text(row['value'])}")
    except sqlite3.IntegrityError:
        print("No keys found in database.")
    con.close()
    return

def delete_clipboard(file_path, key: str):
    """Delete key from sqlite"""
    con = sqlite3.connect(file_path)
    try:
        with con:
            con.execute("DELETE FROM clipboard WHERE key=?", (key))
            print(f"{key} deleted.")
    except sqlite3.IntegrityError:
        print(f"Key '{key}' not found in database.")
    con.close()
    return

def shrink_text(value):
    """Shrink text to fit in clipboard"""
    limit = min(len(value), 50)
    if len(value) > limit:
        return f"{value[:limit]} ..."

    return value

if __name__ == "__main__":
    USAGE   = "Usage: plypboard (s)ave|(u)pdate|(l)oad|(li)st|(d)elete [key]"
    DB_PATH = '$HOME/.config/clypeboard'
    DB_FILE = p_join(p_expand(DB_PATH), 'clipboard.db')
    if not exists(p_expand(DB_FILE)):
        if not exists(p_expand(DB_PATH)):
            mkdir(p_expand(DB_PATH))
        create_db(DB_FILE)

    if len(sys.argv) == 1:
        print(USAGE)
        exit(1)

    elif len(sys.argv) == 2:
        if sys.argv[1] == 'li':
            list_clipboard(DB_FILE)
        else:
            print(USAGE)
            exit(1)

    elif len(sys.argv) == 3:
        if sys.argv[1] == "s":
            save_clipboard(DB_FILE, sys.argv[2])
        elif sys.argv[1] == "u":
            update_clipboard(DB_FILE, sys.argv[2])
        elif sys.argv[1] == "l":
            load_clipboard(DB_FILE, sys.argv[2])
        elif sys.argv[1] == "d":
            delete_clipboard(DB_FILE, sys.argv[2])
        else:
            print(USAGE)
            exit(1)
