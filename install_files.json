{
    "rules": [
        {
            "src": "utils.py",
            "dest": "$HOME/.local/bin"
        },
        {
            "src": "update-system",
            "dest": "$HOME/.local/bin"
        },
        {
            "src": "apt.json",
            "dest": "$HOME/.config/update-system"
        },
        {
            "src": "emerge.json",
            "dest": "$HOME/.config/update-system"
        },
        {
            "src": "pacman.json",
            "dest": "$HOME/.config/update-system"
        }
    ]
}