#! /usr/bin/env python3

import sys
from utils import run, get_process, is_help_needed, show_help


def do():
    from os import system
    cmd = 'xrandr --output "$(xrandr | awk \'/ connected/{print $1; exit; }\')" --auto'
    system(cmd)
    return

def start():
    if len(sys.argv) == 1:
        do()
        return
    if is_help_needed():
        show_help('')
        return
    return

start()