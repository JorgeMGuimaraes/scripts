#! /usr/bin/env python3
"""Update and upgrade a Linux system"""
import sys
import subprocess
from os import system
from os.path import expandvars as p_expand, join as p_join
from utils import is_help_needed, show_help, bcolors, load_data as commands_list

messages = {
    'MSG_UPDATE': "Updating package information from all configured sources...",
    'MSG_UPGRADE': "\nInstalling available upgrades of all packages currently installed on the \
system from the sources configured via sources.list...",
    'MSG_AUTOREMOVE': "\nRemoving packages that were automatically installed to satisfy \
dependencies for other packages and are now no longer needed...",
    'MSG_CLEAN' : "\nClearing out the local repository of retrieved package files..."
}

def get_flavor() -> str:
    """Return Linux distribution name"""
    output = str(subprocess.check_output("uname -a", shell=True)).upper()
    if 'UBUNTU' or 'DEBIAN' in output:
        return 'apt'
    if 'ARCH' in output:
        return 'pacman'
    if 'GENTOO' in output:
        return 'emerge'
    return None

def print_header(rule) -> None:
    """Print header"""
    print(f"\n{bcolors.OKBLUE}{bcolors.BOLD}{rule['msg']}{ bcolors.ENDC}")
    return

def run(rule):
    """Execute a command and print respective message"""
    print(f"\n{bcolors.WARNING}{bcolors.BOLD}{messages[rule['msg']]}{ bcolors.ENDC}")
    if rule['cmd'] != '':
        print(f"{bcolors.OKGREEN}$: {rule['cmd']}{bcolors.ENDC}")
        system(rule['cmd'])
    return

def do_update(path: str) -> None:
    """Execute all commands if flavor is known"""
    flavor = get_flavor()

    if flavor is None:
        print('Flavor not recognized.')
        return

    rules = commands_list(config_file(path, flavor))['rules']
    print_header(rules[0])
    for i in range(1, len(rules)):
        run(rules[i])
    return

def config_file(path: str, flavor: str) -> str:
    """Return path to config file"""
    return p_join(path, f"{flavor}.json")

if __name__ == '__main__':
    if len(sys.argv) == 1:
        rules_path = p_expand('/usr/local/etc')
        do_update(rules_path)
        exit(0)
    if is_help_needed():
        show_help(sys.argv[0])
        exit(0)
