#! /usr/bin/env python

import sys
from utils import run, get_process, is_help_needed, show_help
import subprocess
from os import system

MSG_UPDATE="Updating package information from all configured sources..."
MSG_UPGRADE="\nInstalling available upgrades of all packages currently installed on the system from the sources configured via sources.list..."
MSG_AUTOREMOVE="\nRemoving packages that were automatically installed to satisfy dependencies for other packages and are now no longer needed..."
MSG_CLEAN="\nClearing out the local repository of retrieved package files..."



def get_flavor() -> str:
    output = str(subprocess.check_output("uname -a", shell=True)).upper()
    if 'UBUNTU' in output: return 'ubuntu'
    if 'ARCH' in output: return 'archlinux'
    return None

def upd_command(msg: str, cmd: str):
    print(msg)
    system(cmd)
    return

def do():
    flavor = get_flavor()
    if flavor is None: return
    if flavor == 'ubuntu':
        upd_command(MSG_UPDATE, 'sudo apt update')
        upd_command(MSG_UPGRADE, 'sudo apt -y upgrade')
        upd_command(MSG_AUTOREMOVE, 'sudo apt -y autoremove')
        upd_command(MSG_CLEAN, 'sudo apt -y clean')
        print('Exit\n')
        return
    
    if flavor == 'archlinux':
        upd_command(MSG_UPDATE+MSG_UPGRADE, 'sudo pacman -Syyu')
        upd_command(MSG_AUTOREMOVE+MSG_CLEAN, 'sudo pacman -Scc')
        print('Exit\n')
        return

def start():
    if len(sys.argv) == 1:
        return
    if is_help_needed():
        show_help('')
        return
    do()
    return

start()